---
import "../styles/global.css";
import penguins from "../assets/penguins.json";

const speciesList = penguins.map((penguin) => penguin.species);
const species = [...new Set(speciesList)];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="main-nav" aria-label="Navigation principale">
        <a class="site-name" href="/">TP Astro</a>
        <ul class="main-nav-links">
          <li><a href="/">Accueil</a></li>
          <li><a href="/penguins/">Tous les pingouins</a></li>
          <li><a href="/penguins/island/">Pingouins par île</a></li>
          <li><a href="/penguins/sex/">Pingouins par sexe</a></li>
          <li><a href="/cars/">Voitures par année</a></li>
        </ul>
        <details class="species-menu">
          <summary>Pages par espèce</summary>
          <ul>
            {
              species.map((specie) => (
                <li>
                  <a href={`/penguins/specie/${encodeURIComponent(specie)}`}>
                    {specie}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .site-header {
    border-bottom: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #0f172a;
  }

  .main-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem;
  }

  .site-name {
    font-weight: 700;
  }

  .main-nav-links,
  .species-menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .species-menu {
    position: relative;
  }

  .species-menu summary {
    cursor: pointer;
  }

  .species-menu ul {
    position: absolute;
    z-index: 1;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: max-content;
    padding: 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;
    background: white;
    flex-direction: column;
  }

  .main-nav a,
  .species-menu summary {
    border-radius: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .main-nav a:hover,
  .species-menu summary:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  .main-nav a:focus-visible,
  .species-menu summary:focus-visible {
    outline: 3px solid #f59e0b;
    outline-offset: 3px;
  }

  @media (max-width: 36rem) {
    .species-menu ul {
      position: static;
      min-width: 0;
      margin-top: 0.5rem;
    }
  }
</style>
