---
import * as Plot from "@observablehq/plot";
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import penguins from "../../../assets/penguins.json";

export function getStaticPaths() {
  const speciesList = penguins.map((penguin) => penguin.species);
  const species = [...new Set(speciesList)];

  return species.map((species) => ({
    params: { species },
  }));
}

const { species } = Astro.params;
const filteredPenguins = penguins.filter(
  (penguin) => penguin.species === species,
);
---

<Layout>
  <main class="p-8">
    <h1 class="text-3xl font-bold mb-8">{species}</h1>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(filteredPenguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </main>
</Layout>
